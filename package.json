{
  "name": "busy-octopus",
  "version": "0.0.0",
  "description": "VS Code extension to notify you when an agent or workspace needs attention",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindedtech/busy-octopus.git"
  },
  "scripts": {
    "check": "pnpm check:biome && pnpm check:types && pnpm check:knip",
    "check:biome": "biome check .",
    "check:fix": "biome check --write .",
    "check:knip": "knip",
    "check:types": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm install --frozen-lockfile && pnpm check && pnpm test && pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.20.1",
    "knip": "6.32.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
